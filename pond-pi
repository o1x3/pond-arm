#!/usr/bin/env bash
# Pond for Raspberry Pi 5: build the image, customize it, make an Imager manifest.
#   ./pond-pi build              build packages + image into ./out (needs Docker, arm64 host or emulation)
#   ./pond-pi customize ...      preset user/SSH/Wi-Fi/locale (see ./pond-pi customize --help)
#   ./pond-pi flash IMG [diskN] [-- customize options]   macOS: write, verify, customize a card
#   ./pond-pi manifest IMG.xz    Raspberry Pi Imager manifest (rpi-imager --repo FILE)
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
SRC=${POND_SRC:-$HERE/.src}
ALARM_TARBALL=http://os.archlinuxarm.org/os/ArchLinuxARM-rpi-aarch64-latest.tar.gz
ALARM_KEY=68B3537F39A313B3E574D06777193F152BDBE6A6    # Arch Linux ARM Build System
REPOS=(amarsbar/pond-pkgbuilds)
BUILDER=${POND_BUILDER:-pond-builder}    # container name
VOLUME=${POND_VOLUME:-pond-work}         # case-sensitive scratch volume

builder() { docker exec "$BUILDER" "$@"; }

build() {
    command -v docker >/dev/null || { echo 'pond-pi: Docker is required' >&2; exit 1; }
    docker volume create "$VOLUME" >/dev/null

    if ! docker image inspect alarm:base >/dev/null 2>&1; then
        echo '>>> fetching and verifying the Arch Linux ARM base'
        docker run --rm -v "$VOLUME":/w debian:trixie bash -euc "
            apt-get -qq update >/dev/null; apt-get -qq install -y curl gnupg ca-certificates >/dev/null
            cd /w; curl -sSfLO $ALARM_TARBALL; curl -sSfLO $ALARM_TARBALL.sig
            gpg -q --keyserver hkps://keyserver.ubuntu.com --recv-keys $ALARM_KEY
            gpg -q --verify ArchLinuxARM-rpi-aarch64-latest.tar.gz.sig ArchLinuxARM-rpi-aarch64-latest.tar.gz"
        docker run --rm -v "$VOLUME":/w debian:trixie cat /w/ArchLinuxARM-rpi-aarch64-latest.tar.gz |
            docker import --platform linux/arm64 - alarm:base >/dev/null
    fi

    mkdir -p "$SRC" "$HERE/out"
    for repo in "${REPOS[@]}"; do
        dir=$SRC/${repo#*/}
        if [[ -d $dir ]]; then git -C "$dir" pull -q --ff-only; else git clone -q "https://github.com/$repo.git" "$dir"; fi
    done

    if ! docker container inspect "$BUILDER" >/dev/null 2>&1; then
        docker run -d --name "$BUILDER" --privileged --platform linux/arm64 \
            -v "$VOLUME":/w -v "$HERE:/p" -v "$SRC:/src:ro" alarm:base sleep infinity >/dev/null
        builder bash /p/scripts/setup-builder.sh
    fi
    docker start "$BUILDER" >/dev/null

    builder bash -euc 'mkdir -p /w/ponddb && curl -sSfo /w/ponddb/pond.db https://repo.butterfly.so/x86_64/pond.db'
    builder bash /p/scripts/build-packages.sh
    builder env VERSION="${VERSION:-}" QEMU_TEST="${QEMU_TEST:-0}" OUT=/p/out bash /p/scripts/build-image.sh
    image=$(ls -t "$HERE"/out/pond-pi5-*.img.xz | grep -v qemutest | head -1)
    python3 "$HERE/scripts/pondpi.py" manifest "$image"
}

flash_candidates() {
    # Whole disks that are external or removable media (built-in SD slots report
    # "Internal" + "Removable"). Fixed internal disks and synthesized APFS
    # containers are never offered.
    local d info size name
    for d in $(diskutil list | sed -n 's#^/dev/\(disk[0-9]*\) .*#\1#p'); do
        info=$(diskutil info "$d")
        grep -qE 'Device Location: +External|Removable Media: +Removable' <<<"$info" || continue
        grep -qE 'Virtual: +Yes' <<<"$info" && ! grep -qE 'Protocol: +Disk Image' <<<"$info" && continue
        size=$(sed -n 's/^ *Disk Size: *\([0-9.]* [KMGT]B\).*/\1/p' <<<"$info")
        name=$(sed -n 's/^ *Device \/ Media Name: *//p' <<<"$info")
        printf '%s\t%s\t%s\n' "$d" "$size" "$name"
    done
}

flash() {
    # macOS: pond-pi flash IMAGE.img[.xz] [DISK] [-- customize options]
    [[ $(uname) == Darwin ]] || { echo 'pond-pi flash: macOS only; on Linux use rpi-imager or dd' >&2; exit 1; }
    local image=${1:?usage: pond-pi flash IMAGE [diskN] [-- customize options]}; shift
    [[ -f $image ]] || { echo "pond-pi: no such image: $image" >&2; exit 1; }
    local disk=
    [[ ${1:-} && $1 != -- ]] && { disk=$1; shift; }
    [[ ${1:-} == -- ]] && shift
    local custom=("$@")

    local candidates; candidates=$(flash_candidates)
    [[ -n $candidates ]] || { echo 'pond-pi: no SD card or external disk found' >&2; exit 1; }
    echo 'Removable and external disks:'
    sed 's/^/  /' <<<"$candidates"
    if [[ -z $disk ]]; then read -rp 'Disk to ERASE (e.g. disk4): ' disk; fi
    disk=${disk#/dev/}
    cut -f1 <<<"$candidates" | grep -qx "$disk" ||
        { echo "pond-pi: $disk is not one of the disks above; refusing" >&2; exit 1; }
    read -rp "Everything on $disk will be erased. Type $disk again to continue: " confirm
    [[ $confirm == "$disk" ]] || { echo 'Cancelled.'; exit 1; }

    local sudo=; [[ -w /dev/r$disk ]] || sudo=sudo
    diskutil unmountDisk "/dev/$disk" >/dev/null
    echo ">>> writing $image to /dev/r$disk"
    if [[ $image == *.xz ]]; then
        xz -dc "$image" | $sudo dd of="/dev/r$disk" bs=4m status=progress
    else
        $sudo dd if="$image" of="/dev/r$disk" bs=4m status=progress
    fi
    sync
    # Verify the written bytes against the image (size and sha256 from the build).
    local extract=${image%.xz}; extract=${extract%.img}.img.extract
    if [[ -f $extract ]]; then
        local size sha got
        read -r size sha < "$extract"
        echo '>>> verifying'
        got=$($sudo dd if="/dev/r$disk" bs=1m count=$(( size / 1048576 )) status=none | shasum -a 256 | cut -d' ' -f1)
        [[ $got == "$sha" ]] || { echo 'pond-pi: verification FAILED; the card may be faulty' >&2; exit 1; }
        echo 'verified'
    fi
    if (( ${#custom[@]} )); then
        diskutil mount "/dev/${disk}s1" >/dev/null
        local boot; boot=$(diskutil info "${disk}s1" | sed -n 's/^ *Mount Point: *//p')
        [[ -d $boot ]] || { echo "pond-pi: could not mount the boot partition of $disk" >&2; exit 1; }
        python3 "$HERE/scripts/pondpi.py" customize "$boot" "${custom[@]}"
    fi
    diskutil eject "/dev/$disk" >/dev/null
    echo 'Done. Put the card in the Pi 5 and power on.'
}

case ${1:-} in
    build) shift; build "$@" ;;
    flash) shift; flash "$@" ;;
    customize|manifest) exec python3 "$HERE/scripts/pondpi.py" "$@" ;;
    *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

[Unit]
Description=Pond: create the first user account on tty1
ConditionPathExists=!/var/lib/pond/setup-done
After=pond-firstboot.service systemd-vconsole-setup.service
Before=display-manager.service getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/lib/pond-pi/setup.sh
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target

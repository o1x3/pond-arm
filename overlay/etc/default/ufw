# Keep UFW's packaged before/after rules for replies and network infrastructure.
IPV6=yes
DEFAULT_INPUT_POLICY="DROP"
DEFAULT_OUTPUT_POLICY="ACCEPT"
DEFAULT_FORWARD_POLICY="DROP"
DEFAULT_APPLICATION_POLICY="SKIP"

# Preserve chains managed by other software.
MANAGE_BUILTINS=no
# Apply UFW's network sysctls after systemd-sysctl.service.
IPT_SYSCTL=/etc/ufw/sysctl.conf
IPT_MODULES=""
